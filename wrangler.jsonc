{
  // Product site: static assets only, no Worker code.
  // install.sh is committed in public/ (copied from the git-master repo).
  "name": "gitmaster-site",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "gitmaster.dev", "custom_domain": true },
    { "pattern": "www.gitmaster.dev", "custom_domain": true }
  ]
}
